{
  "name": "dosya-inceleme-masasi",
  "private": true,
  "version": "0.2.0",
  "description": "Yerel, şifreli, kaynak izlenebilir dosya inceleme masası",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.11 <26",
    "pnpm": ">=10"
  },
  "scripts": {
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "contracts:generate": "node packages/contracts/scripts/generate.mjs --check",
    "contracts:write": "node packages/contracts/scripts/generate.mjs --write"
  },
  "devDependencies": {
    "typescript": "5.6.3"
  }
}
