{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dosya İnceleme Masası",
  "version": "0.1.0",
  "identifier": "tr.hukuk.dosya-inceleme-masasi",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dosya İnceleme Masası",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [],
    "category": "Productivity",
    "shortDescription": "Yerel, şifreli dosya inceleme masası",
    "longDescription": "Avukatlar için kaynak izlenebilir, yerel ve şifreli dosya inceleme uygulaması."
  }
}
